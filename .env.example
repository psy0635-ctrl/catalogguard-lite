# 역할: 로컬 PostgreSQL 연결과 JWT 인증에 필요한 환경변수 예시를 제공합니다.
DATABASE_URL=postgresql+psycopg://catalogguard_user:CHANGE_ME@localhost:5432/catalogguard_lite
TEST_DATABASE_URL=postgresql+psycopg://catalogguard_test_user:CHANGE_ME@localhost:5432/catalogguard_lite_test
CELERY_BROKER_URL=redis://localhost:6379/0
REDIS_JOB_URL=redis://localhost:6379/1
INSPECTION_JOB_DIR=var/inspection_jobs
INSPECTION_JOB_TTL_SECONDS=86400
# JWT Access Token 서명 secret입니다. 실제 값은 절대 커밋하지 말고 로컬에서만 CHANGE_ME를 교체하세요.
CATALOGGUARD_JWT_SECRET=CHANGE_ME
# 생략하면 3600(1시간)이 기본값입니다.
CATALOGGUARD_JWT_ACCESS_TOKEN_TTL_SECONDS=3600
# Prometheus GET /metrics endpoint 활성화 여부입니다. true/1/yes(대소문자 무관)일 때만
# 활성화되며, 생략하거나 다른 값이면 /metrics는 404로 비공개 상태를 유지합니다.
CATALOGGUARD_METRICS_ENABLED=false
# Trusted HTTP feed configuration. Keep the actual URL (which can contain a
# credential) out of Git; Airflow passes it only to its scheduler/task runtime.
CATALOGGUARD_ETL_HTTP_FEED_URL=https://CHANGE_ME.invalid/catalog.csv
CATALOGGUARD_ETL_HTTP_FEED_FILENAME=supplier_feed.csv

# Airflow foundation metadata DB. These values are isolated from CatalogGuard's
# DATABASE_URL and must be replaced with local secrets before Compose is started.
AIRFLOW_METADATA_POSTGRES_USER=airflow
AIRFLOW_METADATA_POSTGRES_PASSWORD=CHANGE_ME
AIRFLOW_METADATA_POSTGRES_DB=airflow
AIRFLOW_FERNET_KEY=CHANGE_ME_GENERATE_A_VALID_FERNET_KEY
AIRFLOW_API_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_VALUE
AIRFLOW_API_AUTH_JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_VALUE
# Airflow API is published separately from CatalogGuard FastAPI (default 8001).
AIRFLOW_API_HOST_PORT=8088
